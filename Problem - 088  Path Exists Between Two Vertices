class Solution {
  public:
    bool dfs(int u, vector<vector<int>> &adj, int v, vector<bool> &visited){
      visited[u]=true;
      if(u==v) return true;

      for(int ad: adj[u]){
        if(!visited[ad])
          { if(dfs(ad, adj, v, visited)) return true; }
      }
      return false;
    }


    bool checkPath(vector<vector<int>> &adj, int u, int v){
      int n=adj.size(); 
      vector<bool> visited(n, false);
      return dfs(u, adj, v, visited);
    }
};
